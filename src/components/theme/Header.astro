---
interface Props {
  headerType?: string;
}

const { headerType = 'default' } = Astro.props;

const Navbar = (await import(`../snippets/navbar/${headerType}/Navbar.astro`))
  .default;
---

<header class='container'>
  <Navbar />
</header>

<style>
  header {
    position: relative;
  }
</style>
