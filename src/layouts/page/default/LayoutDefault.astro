---
import Html from '@/layouts/Html.astro';
import Header from '@comp/theme/Header.astro';
import Footer from '@comp//theme/Footer.astro';

interface Props {
  title?: string;
  headerType?: string;
}

const { title, headerType } = Astro.props;
---

<Html title={title}>
  <Header headerType={headerType} />

  <main class='main'>
    <slot />
  </main>

  <Footer />
</Html>
