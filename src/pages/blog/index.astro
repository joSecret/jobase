---
import { getCollection } from 'astro:content';
import LayoutDefault from '@/layouts/page/default/LayoutDefault.astro';
import { SITE } from '@/const';
import FormattedDate from '@comp/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<LayoutDefault title='Blog'>
  <section class='container'>
    <ul class='list-unstyled'>
      {
        posts.map((post) => (
          <li>
            <a href={`/${SITE.BASE_PATH}/blog/${post.slug}/`}>
              <img
                width={720}
                height={360}
                src={`/${SITE.BASE_PATH}${post.data.heroImage}`}
                alt=''
                class='img-width'
              />
              <h4 class='title'>{post.data.title}</h4>
              <p class='date'>
                <FormattedDate date={post.data.pubDate} />
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</LayoutDefault>
