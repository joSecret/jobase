---
import '@pcss/components/badge.pcss.css';
interface Props {
  underWork?: boolean;
  title: string;
  description?: string;
  content?: string;
}

const { underWork = false, title, description } = Astro.props;
---

<div class='section container'>
  <header>
    <h2 class='h1 section--title'>
      {title}

      {underWork && <sup class='badge badge-info'>under work</sup>}
    </h2>

    <div class='section--description'>{description}</div>
  </header>

  {
    !underWork && (
      <div class='section--content container container--full'>
        <slot />
      </div>
    )
  }
</div>

<style>
  .section {
    --_section_pb: 100px;
  }
  .section header {
    justify-self: center;
    max-width: 465px;
    text-align: center;
    padding-block: var(--_section_pb);

    &:not(:has(.section--content)) {
      padding-block-end: 0px;
    }
  }
</style>
